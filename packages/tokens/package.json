{
  "name": "@no-problem/design-tokens",
  "version": "0.0.0",
  "description": "Design tokens in DTCG format, built for React Native, Tailwind and CSS from one source.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind": {
      "types": "./dist/generated/tailwind-preset.d.ts",
      "default": "./dist/generated/tailwind-preset.js"
    },
    "./css": "./assets/variables.css",
    "./tokens/*": "./tokens/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets",
    "tokens",
    "README.md"
  ],
  "scripts": {
    "generate": "node build.mjs",
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "style-dictionary": "^5.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
